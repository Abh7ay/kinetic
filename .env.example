# Copy this file to `.env.local` for local development and fill values.

# Cloudinary (server-side keys stored securely in deployment platform)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: public site URL used for metadata or absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
